<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Windows 10 1903+: the process's code page is UTF-8, so its narrow strings (argv, CreateFileA, fopen and fstream
     paths, getenv, ggml's) are the UTF-8 the programs pass around (otherwise a path outside the system's ANSI code
     page reaches them as "?") -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
